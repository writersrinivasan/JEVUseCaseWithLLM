# No API key goes here: each visitor enters their own Groq key in the app,
# and it is kept only in that browser tab's sessionStorage.
# Optional model overrides (also settable in Vercel → Project → Settings → Environment Variables)
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
